{
  "rules": {
    ".read": false,
    ".write": false,
    "earthlocations": {
      ".read": true,
      "$session": {
        ".write": "auth != null && newData.exists() && newData.child('uid').val() === auth.uid && (!data.exists() || data.child('uid').val() === auth.uid)",
        "uid": {
          ".validate": "newData.isString() && newData.val() === auth.uid"
        },
        "key": {
          ".validate": "newData.isString() && newData.val() === $session"
        },
        "lat": {
          ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90"
        },
        "lon": {
          ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180"
        },
        "timeStamp": {
          ".validate": "newData.isNumber()"
        },
        "date": {
          ".validate": "newData.isString() && newData.val().length <= 120"
        },
        "showId": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "leave": {
          ".validate": "newData.isBoolean()"
        },
        "lastSeen": {
          ".validate": "newData.isNumber()"
        },
        "endedAt": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
