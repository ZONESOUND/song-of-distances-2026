# Test-mode environment. Committed on purpose.
#
# The suite asserts what an *unconfigured* build does (see
# src/runtimeConfig.test.js, "defaults every unconfigured build to local
# fixture mode"). Without this file, a developer's own .env.local — for
# example a staging Firebase config — leaks into the test run and turns those
# assertions red for reasons that have nothing to do with the code.
#
# Vite loads .env.[mode] at a higher priority than .env.local, and Vitest runs
# in mode "test", so blanking the values here restores the unconfigured state.
# They are left empty rather than set to "fixture" so runtimeConfig still
# exercises its own fallback defaults.

REACT_APP_DATA_MODE=
REACT_APP_LOCATION_MODE=
REACT_APP_SOCKET_MODE=
REACT_APP_SOCKET_URL=
REACT_APP_OSC_OUTPUT=
REACT_APP_SHOW_DIAGNOSTICS=

REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_DATABASE_URL=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
